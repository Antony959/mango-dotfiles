# ===============================================
# Configuração do Mako - Everforest Dark Medium
# ===============================================

# --- Comportamento ---
max-visible=5
sort=-time
layer=overlay
anchor=top-right
margin=20
padding=15
border-size=2
border-radius=2

font=sans-serif 10

default-timeout=5000
ignore-timeout=1

background-color=#2D353B
text-color=#D3C6AA
border-color=#7A8478
progress-color=over #A7C080

[urgency=low]
default-timeout=5000

[urgency=normal]
default-timeout=5000

[urgency=critical]
background-color=#e67e80
text-color=#2d353b
default-timeout=5000 
